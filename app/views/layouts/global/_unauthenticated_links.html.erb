<div class="flex items-center space-x-3"
     id="unauthenticated-links">
  <%= link_to new_session_path,
              class: "btn btn-ghost" do %>
    Sign in
  <% end %>
  <%= link_to new_registration_path,
              class: "btn btn-primary" do %>
    <span>
      Sign up
    </span>
    <%= icon("arrow-right") %>
  <% end %>
</div>

