<%= content_for(:title) do %>
  Chapters
<% end %>

<%= content_for(:breadcrumbs) do %>
  <%= render "shared/components/breadcrumbs/breadcrumbs" do %>
    <%= render "shared/components/breadcrumbs/breadcrumb_link",
               text: "Chapters" %>
  <% end %>
<% end %>

<div class="space-y-12">

  <% if @chapters.any? %>
    <%= render "shared/components/page_header",
                title: "Chapters",
                button_link_path: new_chapter_path %>

    <div class="space-y-6">

      <%= render "shared/components/listings/listings" do %>
        <% @chapters.each do |chapter| %>
          <%= render "chapters/chapter_listing",
                        chapter: chapter %>
        <% end %>
      <% end %>

      <% if @pagy.pages > 1 %>
        <div class="pagy-container">
          <%== pagy_nav(@pagy) %>
        </div>
      <% end %>

    </div>

  <% else %>
    <%= render "shared/components/listings/no_listings",
                singular_object_name: "chapter",
                plural_object_name: "chapters",
                new_path: new_chapter_path %>
  <% end %>

</div>
