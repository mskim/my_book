<%= render "shared/components/dropdown/dropdown",
           menu_position: "left-auto right-8 -top-4" do %>

  <%= render "shared/components/dropdown/dropdown_link",
             link_text: "View Chapter",
             link_path: chapter_path(chapter),
             icon_name: "arrow-right" %>


  <%= render "shared/components/dropdown/dropdown_link",
               link_text: "Edit Chapter",
               link_path: edit_chapter_path(chapter),
               icon_name: "square-pen" %>


  <%= render "shared/components/dropdown/dropdown_link",
               link_text: "Delete Chapter",
               icon_name: "trash",
               link_path: chapter_path(chapter),
               link_method: :delete,
               button_link: true,
               data: {
                   turbo_method: :delete,
                   turbo_confirm: "Really delete chapter?"
               } %>

<% end %>
