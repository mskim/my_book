<%= render "shared/components/dropdown/dropdown",
           menu_position: "left-auto right-8 -top-4" do %>

  <%= render "shared/components/dropdown/dropdown_link",
             link_text: "View Book",
             link_path: book_path(book),
             icon_name: "arrow-right" %>


  <%= render "shared/components/dropdown/dropdown_link",
               link_text: "Edit Book",
               link_path: edit_book_path(book),
               icon_name: "square-pen" %>


  <%= render "shared/components/dropdown/dropdown_link",
               link_text: "Delete Book",
               icon_name: "trash",
               link_path: book_path(book),
               link_method: :delete,
               button_link: true,
               data: {
                   turbo_method: :delete,
                   turbo_confirm: "Really delete book?"
               } %>

<% end %>
