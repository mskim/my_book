<%= form_with(model: @section,
               url: @section.new_record? ? sections_path : section_path(@section),
               local: true) do |f| %>
  <%= render 'shared/components/forms/errors', model: @section %>

  <div class="space-y-8">

    <%= render "shared/components/forms/field",
                 form: f,
                 label: "Title",
                 name: :title do %>
      <%= f.text_field :title,
                        placeholder: "Title",
                        class: form_control_classes,
                        autofocus: true %>
    <% end %>

    
    <% unless @section.new_record? %>
      
      <%= render "shared/components/forms/field",
                  form: f,
                  label: "Position",
                  name: :position do %>
        <%= f.number_field :position,
                placeholder: "Position",
                class: form_control_classes%>
      <% end %>
      
      <%= render "shared/components/forms/field",
                  form: f,
                  label: "Chapter",
                  name: :chapter do %>
        <%= f.text_field :chapter,
                placeholder: "Chapter",
                class: form_control_classes%>
      <% end %>
      
    <% end %>
    
    <div>
      <%= f.submit class: "btn btn-primary" %>
    </div>

  </div>
<% end %>
