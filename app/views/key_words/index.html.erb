<%= content_for(:title) do %>
  Key_words
<% end %>

<%= content_for(:breadcrumbs) do %>
  <%= render "shared/components/breadcrumbs/breadcrumbs" do %>
    <%= render "shared/components/breadcrumbs/breadcrumb_link",
               text: "Key_words" %>
  <% end %>
<% end %>

<div class="space-y-12">

  <% if @key_words.any? %>
    <%= render "shared/components/page_header",
                title: "Key_words",
                button_link_path: new_key_word_path %>

    <div class="space-y-6">

      <%= render "shared/components/listings/listings" do %>
        <% @key_words.each do |key_word| %>
          <%= render "key_words/key_word_listing",
                        key_word: key_word %>
        <% end %>
      <% end %>

      <% if @pagy.pages > 1 %>
        <div class="pagy-container">
          <%== pagy_nav(@pagy) %>
        </div>
      <% end %>

    </div>

  <% else %>
    <%= render "shared/components/listings/no_listings",
                singular_object_name: "key_word",
                plural_object_name: "key_words",
                new_path: new_key_word_path %>
  <% end %>

</div>
